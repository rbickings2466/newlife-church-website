########################################
# Church Website Environment Variables
#
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
########################################

########################################
# Firebase Configuration
# Get these from your Firebase console:
# https://console.firebase.google.com/
########################################
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

########################################
# Site Configuration
########################################
# Your church website URL (used for SEO and sharing)
VITE_SITE_URL=https://www.yourchurch.org

# Comma-separated list of admin email addresses
# These users will have access to admin features
VITE_ADMIN_EMAILS=admin@yourchurch.org,pastor@yourchurch.org

########################################
# YouTube API Configuration
# Get your API key from Google Cloud Console:
# https://console.cloud.google.com/
########################################
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# Your church's YouTube channel ID
# Find it: Go to your channel > Click "More about this channel" > Copy Channel ID
VITE_YOUTUBE_CHANNEL_ID=your_channel_id

########################################
# EmailJS Configuration
# Get these from your EmailJS dashboard:
# https://www.emailjs.com/
########################################
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

########################################
# Gemini AI Configuration (Optional)
# For the "Ask [Church Name]" chatbot feature
# Get your API key from Google AI Studio:
# https://aistudio.google.com/
########################################
# Gemini API Key (SECURE - Do NOT use VITE_ prefix)
# This key is used by the backend Netlify function and must remain private.
GEMINI_API_KEY=your_gemini_api_key_here
